{%- liquid
  assign img = product.featured_image
  assign is_sold_out = true
  for v in product.variants
    if v.available
      assign is_sold_out = false
      break
    endif
  endfor

  # Global creation-order number: find this product's position in a
  # store-wide list sorted by created_at ascending. First product ever
  # added to the store = 001, second = 002, etc.
  # `all_sorted` must be passed in from the parent section (sorted once
  # per page). If not passed, we fall back to the local grid position.
  assign num = 0
  if all_sorted
    for p in all_sorted
      if p.handle == product.handle
        assign num = forloop.index
        break
      endif
    endfor
  endif
  if num == 0
    assign num = index | plus: 1
  endif
  assign padded = num | prepend: '000' | slice: -3, 3

  assign show_numbers = true
  if show_numbers_override == false
    assign show_numbers = false
  endif
-%}

<a
  href="{{ product.url }}"
  class="product-card"
  style="animation-delay: {{ index | times: 30 }}ms;"
>
  <div class="product-card__inner">
    <div class="product-card__image-wrap">
      {%- if img -%}
        <img
          class="product-card__image"
          src="{{ img | image_url: width: 600 }}"
          srcset="
            {{ img | image_url: width: 300 }} 300w,
            {{ img | image_url: width: 600 }} 600w,
            {{ img | image_url: width: 900 }} 900w
          "
          sizes="33vw"
          alt="{{ img.alt | default: product.title | escape }}"
          loading="{% if index < 9 %}eager{% else %}lazy{% endif %}"
          {% if index == 0 %}fetchpriority="high"{% endif %}
          draggable="false"
          decoding="async"
          width="{{ img.width }}"
          height="{{ img.height }}"
        >
      {%- else -%}
        <div class="product-card__no-image">No image</div>
      {%- endif -%}
    </div>
    <p class="product-card__name{% if is_sold_out %} is-sold-out{% endif %}">
      {%- if show_numbers -%}
        {{ padded }}
      {%- else -%}
        {{ product.title }}
      {%- endif -%}
    </p>
  </div>
</a>
