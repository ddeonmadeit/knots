<div style="padding: 80px 24px; text-align: center; font-family: var(--font-body);">
  <h1 style="font-family: var(--font-display); text-transform: uppercase; letter-spacing: .2em; font-size: 24px; margin-bottom: 16px;">
    {{ shop.name }}
  </h1>
  <p style="color: hsl(var(--muted-foreground)); margin-bottom: 24px;">Opening soon</p>

  {% form 'storefront_password' %}
    <input type="password" name="password" placeholder="Password">
    <button type="submit">Enter</button>
    {{ form.errors | default_errors }}
  {% endform %}
</div>
